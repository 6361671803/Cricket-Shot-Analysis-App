# Copy this file to .env and fill in your own values. .env is gitignored -
# never commit real API keys.

# Fallback order for shot classification's LLM tier (Phase 3, tier 2) -
# comma-separated. Only the first provider is used under normal
# conditions; a later provider is only ever tried as a backup for the
# specific case where the one before it has exhausted its own daily
# quota/rate limit this session (an HTTP 429). Any other failure (no key
# configured, network error, unparseable response) stops the chain
# immediately and falls through to the rule-based classifier - it does
# not cascade to a backup provider. Implemented: "gemini", "openrouter".
# Unimplemented stubs exist for "anthropic"/"openai" in
# shot_classifier_llm.py but naming them here does nothing yet.
LLM_PROVIDER_ORDER=gemini,openrouter

# Model to use for the gemini provider. gemini-3.1-flash-lite is confirmed
# working on the free tier as of August 2026 (verified directly against
# the API - gemini-2.5-flash and gemini-2.0-flash both failed:
# deprecated-for-new-users or zero free quota). Check
# https://aistudio.google.com/app/apikey for current free-tier model
# names - Google changes these without much notice, and what's free can
# change faster than this comment will get updated.
LLM_MODEL=gemini-3.1-flash-lite

# Get a free Gemini API key (no credit card required) at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Backup provider, tried only when gemini specifically exhausts its own
# daily quota/rate limit (not for a missing key or other failures - see
# the LLM_PROVIDER_ORDER comment above). Get a free API key at:
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use for the openrouter provider. minimax/minimax-m3:free is
# confirmed working as of September 2026 - tested directly against the
# live OpenRouter API with this project's actual classification prompt.
# Note: OpenRouter's free models are capped at 50 requests/day per model
# (per account) unless the account adds $10 credit, which raises the cap
# to 1000/day - relevant if this tier gets used heavily. Free-tier model
# availability changes over time, same as Gemini's above - check
# https://openrouter.ai/models (filter: image input) if this stops working.
OPENROUTER_MODEL=minimax/minimax-m3:free

# Set to false to fully disable the LLM fallback tier entirely (pipeline
# then goes straight from the local ML model to the rule-based classifier).
LLM_FALLBACK_ENABLED=true

# Soft cap on LLM calls per app run, comfortably under Gemini's free daily
# quota so a long-running dev server doesn't blow through it unnoticed.
LLM_MAX_CALLS_PER_SESSION=400
