# Copy this file to .env and fill in your own values. .env is gitignored -
# never commit real API keys.

# Which LLM fallback tier to use for shot classification (Phase 3, tier 2).
# Only "gemini" is implemented right now.
LLM_PROVIDER=gemini

# Model to use. gemini-3.1-flash-lite is confirmed working on the free tier
# as of August 2026 (verified directly against the API - gemini-2.5-flash
# and gemini-2.0-flash both failed: deprecated-for-new-users or zero free
# quota). Check https://aistudio.google.com/app/apikey for current
# free-tier model names - Google changes these without much notice, and
# what's free can change faster than this comment will get updated.
LLM_MODEL=gemini-3.1-flash-lite

# Get a free API key (no credit card required) at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Set to false to fully disable the LLM fallback tier (pipeline then goes
# straight from the local ML model to the rule-based classifier).
LLM_FALLBACK_ENABLED=true

# Soft cap on LLM calls per app run, comfortably under Gemini's free daily
# quota so a long-running dev server doesn't blow through it unnoticed.
LLM_MAX_CALLS_PER_SESSION=400
